# Shared environment defaults for local development
PROJECT_NAME=palmreadmobile

# API
API_BASE_URL=http://51.255.201.31:8080

# Laravel API
LARAVEL_APP_ENV=local
LARAVEL_APP_DEBUG=true
LARAVEL_APP_URL=http://localhost:8080
LARAVEL_DB_CONNECTION=pgsql
LARAVEL_DB_HOST=postgres
LARAVEL_DB_PORT=5432
LARAVEL_DB_DATABASE=palmread
LARAVEL_DB_USERNAME=palmread
LARAVEL_DB_PASSWORD=palmread
LARAVEL_QUEUE_CONNECTION=redis
LARAVEL_REDIS_HOST=redis
LARAVEL_REDIS_PORT=6379
LARAVEL_REDIS_CLIENT=predis
LARAVEL_CACHE_STORE=file
LARAVEL_SESSION_DRIVER=file
LARAVEL_MAIL_MAILER=smtp
# SMTP settings (example). For SSL use port 465 + encryption "ssl".
LARAVEL_MAIL_HOST=
LARAVEL_MAIL_PORT=587
LARAVEL_MAIL_USERNAME=
LARAVEL_MAIL_PASSWORD=
LARAVEL_MAIL_ENCRYPTION=tls
LARAVEL_MAIL_FROM_ADDRESS=
LARAVEL_MAIL_FROM_NAME=PalmRead
LARAVEL_CV_SERVICE_BASE_URL=http://cv_service:8001
LARAVEL_PALM_STORAGE_DISK=palms
LARAVEL_PALM_IMAGE_RETENTION_DAYS=30
LARAVEL_PALM_UPLOAD_MAX_MB=8
LARAVEL_PALM_HISTORY_LIMIT=10
LARAVEL_PALM_LLM_ENABLED=false
LARAVEL_PALM_LLM_BASE_URL=http://ollama:11434
LARAVEL_PALM_LLM_MODEL=llama3.2:1b
LARAVEL_PALM_LLM_TIMEOUT_SECONDS=60
LARAVEL_PALM_LLM_TEMPERATURE=0
LARAVEL_PALM_LLM_NUM_PREDICT=420
LARAVEL_PALM_LLM_SEED=42
LARAVEL_PALM_LLM_FORCE_ENGLISH=true
LARAVEL_PALM_LLM_ENGLISH_MODEL=llama3.2:1b
LARAVEL_PALM_LLM_REQUIRE_SUCCESS=false
LARAVEL_PALM_OTP_TTL_SECONDS=600
LARAVEL_PALM_OTP_RESEND_AFTER_SECONDS=45
LARAVEL_PALM_OTP_MAX_ATTEMPTS=5
LARAVEL_PALM_OTP_DEBUG_ECHO=false
LARAVEL_PALM_FCM_SERVER_KEY=
LARAVEL_PALM_FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
LARAVEL_PALM_ADMIN_USERNAME=admin
LARAVEL_PALM_ADMIN_PASSWORD=change-me
LARAVEL_PALM_ADMIN_USERS_PER_PAGE=25
LARAVEL_PALM_ADMIN_UPLOADS_PER_PAGE=30

# CV service
CV_HOST=0.0.0.0
CV_PORT=8001
CV_MAX_IMAGE_SIDE=1600
CV_ROI_SIZE=512
CV_TIMEOUT_MS=8000
CV_NUM_THREADS=1
CV_LOG_LEVEL=INFO

# Flutter
FLUTTER_POLL_INTERVAL_SECONDS=2
FLUTTER_UPLOAD_TIMEOUT_SECONDS=30
FLUTTER_API_BASE_PATH=/palmread
