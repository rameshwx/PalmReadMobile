APP_NAME=PalmReadAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
# For sqlite local dev
DB_DATABASE=/var/www/html/database/database.sqlite
# For PostgreSQL production
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=palmread
# DB_USERNAME=palmread
# DB_PASSWORD=secret

QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=predis

CACHE_STORE=file
SESSION_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost

CV_SERVICE_BASE_URL=http://127.0.0.1:8001
PALM_STORAGE_DISK=palms
PALM_IMAGE_RETENTION_DAYS=30
PALM_UPLOAD_MAX_MB=8
PALM_POLLING_RECOMMENDED_SECONDS=2
PALM_HISTORY_LIMIT=10
PALM_LLM_ENABLED=false
PALM_LLM_BASE_URL=http://127.0.0.1:11434
PALM_LLM_MODEL=llama3.2:1b
PALM_LLM_TIMEOUT_SECONDS=60
PALM_LLM_TEMPERATURE=0
PALM_LLM_NUM_PREDICT=420
PALM_LLM_SEED=42
PALM_LLM_FORCE_ENGLISH=true
PALM_LLM_ENGLISH_MODEL=llama3.2:1b
PALM_LLM_REQUIRE_SUCCESS=false
PALM_OTP_TTL_SECONDS=600
PALM_OTP_RESEND_AFTER_SECONDS=45
PALM_OTP_MAX_ATTEMPTS=5
PALM_OTP_DEBUG_ECHO=false
PALM_FCM_PROJECT_ID=palm-read-5cfa3
PALM_FCM_SERVICE_ACCOUNT_PATH=
PALM_FCM_SERVICE_ACCOUNT_BASE64=
PALM_ADMIN_USERNAME=admin
PALM_ADMIN_PASSWORD=change-me
PALM_ADMIN_USERS_PER_PAGE=25
PALM_ADMIN_UPLOADS_PER_PAGE=30
